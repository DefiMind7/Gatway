// Gateway descentralizado de pagamentos — schema Prisma
//
// Modelo de negócio: BROKER.
//   cliente paga fiat -> on-ramp credita USDC no vault -> swap para SOL
//   -> cliente recebe SOL menos a taxa (imediato)
//   -> a taxa fica retida no vault como LUCRO
//   -> o lucro acumulado é distribuído aos sócios em horário fixo diário.
//
// Dev: SQLite. Para produção troque o provider para "postgresql" (BigInt/
// Decimal/String são portáveis) e rode migrations.

generator client {
  provider = "prisma-client-js"
  // `rhel-openssl-3.0.x` é o runtime Node da Vercel/Lambda. Sem ele, o client
  // gerado numa máquina de build diferente da de execução não encontra o query
  // engine — falha clássica de Prisma em serverless.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Uma ordem = um pagamento fiat.
/// PENDING -> PROCESSING -> SWAPPED -> SETTLED -> DISTRIBUTED (ou FAILED).
///   SWAPPED     = o SOL desta ordem está no vault
///   SETTLED     = o cliente já recebeu a parte dele; o lucro está acumulado
///   DISTRIBUTED = o lucro desta ordem entrou num PayoutRun concluído
/// Ver `OrderStatus` em src/types/index.ts (SQLite não tem enum nativo).
model Order {
  id String @id @default(cuid())

  // ── Identidade no provedor fiat (chave de idempotência do webhook) ──
  provider          String
  providerEventId   String  @unique
  providerPaymentId String?
  customerRef       String?

  // ── Lado fiat ──
  fiatCurrency String
  fiatAmount   Decimal

  // ── Lado on-chain: entrada (stablecoin creditada pelo on-ramp) ──
  inputMint        String
  inputAmountRaw   BigInt
  depositSignature String?

  // ── Destino do cliente (modelo broker) ──
  customerWallet          String
  customerLamports        BigInt?
  customerPayoutSignature String?

  // ── Taxa aplicada nesta operação (snapshot: auditável para sempre) ──
  /// Custo real do on-ramp em bps, medido em tempo real no momento da cotação.
  providerCostBps Int?
  /// Nossa margem em bps, vinda das configurações do admin.
  marginBps       Int?
  /// Taxa efetiva cobrada = providerCostBps + marginBps.
  feeBps          Int?
  /// Provedor escolhido como mais barato no momento da operação.
  feeSourceProvider String?

  // ── Retenção em fiat (modelo cartão: 30% fica na conta, 70% vira SOL) ──
  /// Fração do valor pago que NÃO foi convertida, em bps. Snapshot.
  fiatRetainedBps    Int?
  /// Valor absoluto retido, na moeda do pagamento. É a receita desta ordem
  /// quando ela vem por um trilho com retenção — o lucro dela não está na
  /// chain, está na conta bancária/PSP do operador.
  retainedFiatAmount Decimal?

  // ── Swap (Jupiter v6) ──
  swapSignature       String?
  solReceivedLamports BigInt?
  quotedOutLamports   BigInt?
  priceImpactPct      String?

  // ── Custo de rede repassado ao cliente ──
  /// Lamports descontados do cliente para cobrir swap + liquidação.
  /// Ficam no vault como REEMBOLSO, não como lucro: distribuí-los aos sócios
  /// drenaria justamente o saldo que paga as taxas das próximas ordens.
  networkCostLamports BigInt?
  /// Quando este custo foi varrido para a carteira de gás. Null = ainda no vault.
  gasSweptAt          DateTime?

  // ── Lucro retido desta ordem ──
  profitLamports BigInt?
  payoutRunId    String?
  payoutRun      PayoutRun? @relation(fields: [payoutRunId], references: [id])

  // ── Liquidação manual (operador entregou por fora) ──
  /// true quando o SOL não saiu pela pipeline: o operador mandou da carteira
  /// dele e registrou aqui. Separado do fluxo automático de propósito — na
  /// auditoria, "quem apertou o botão" é a primeira pergunta.
  manualSettlement Boolean @default(false)
  /// Quem registrou, e a observação que ele deixou.
  settledBy        String?
  settlementNote   String?

  // ── Máquina de estados ──
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  lastError String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  swappedAt     DateTime?
  settledAt     DateTime?
  distributedAt DateTime?

  @@index([status, createdAt])
  @@index([provider, providerPaymentId])
  @@index([payoutRunId])
}

/// Uma execução da distribuição de lucro (agendada ou manual).
/// Agrupa as ordens cujo lucro foi pago e as transferências efetuadas.
model PayoutRun {
  id String @id @default(cuid())

  /// Instante para o qual a execução foi agendada (o horário fixo diário).
  scheduledFor DateTime
  /// MANUAL quando disparada pelo admin, SCHEDULED quando pelo timer.
  trigger      String   @default("SCHEDULED")

  /// Lucro total elegível no momento da execução.
  totalLamports BigInt @default(0)
  /// Quantas ordens entraram nesta execução.
  orderCount    Int    @default(0)

  status    String  @default("RUNNING") // RUNNING | COMPLETED | PARTIAL | FAILED | SKIPPED
  skipReason String?
  lastError String?

  orders  Order[]
  payouts Payout[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, scheduledFor])
}

/// Uma linha por destinatário por execução — base de reconciliação.
/// Os bps ficam gravados aqui: mudar a config no admin depois não reescreve
/// o histórico.
model Payout {
  id    String    @id @default(cuid())
  runId String
  run   PayoutRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  label    String
  address  String
  bps      Int
  lamports BigInt

  batchIndex Int     @default(0)
  signature  String?
  status     String  @default("PENDING") // PENDING | SENT | FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, address])
  @@index([address])
}

/// Destinatários do split, gerenciados pelo admin (substitui RECIPIENTS_JSON,
/// que agora serve apenas como seed na primeira subida).
/// A soma dos bps dos ativos precisa ser exatamente 10000.
model Recipient {
  id      String  @id @default(cuid())
  label   String
  address String  @unique
  bps     Int
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Configuração global editável no admin. Linha única (id = "default").
model GatewaySettings {
  id String @id @default("default")

  // ── Distribuição de lucro ──
  /// Habilita/desabilita a distribuição automática.
  distributionEnabled Boolean @default(true)
  /// Hora local (0-23) do disparo diário.
  distributionHour    Int     @default(0)
  /// Minuto local (0-59) do disparo diário.
  distributionMinute  Int     @default(0)
  /// Timezone IANA de referência (ex.: "Europe/Lisbon", "America/Sao_Paulo").
  distributionTimezone String @default("UTC")
  /// Lucro mínimo acumulado para a execução valer a fee de rede.
  minProfitLamports   BigInt  @default(5000000)

  // ── Taxa ──
  /// Nossa margem sobre o custo do provedor, em bps.
  marginBps           Int     @default(150)
  /// Piso e teto de sanidade para a taxa efetiva cobrada ao cliente.
  minFeeBps           Int     @default(50)
  maxFeeBps           Int     @default(1000)
  /// Custo assumido quando nenhum provedor responde (fail-safe conservador).
  fallbackProviderCostBps Int @default(200)

  // ── Retenção em fiat ──
  /// Quanto do valor pago fica em fiat na conta do operador, em bps.
  /// 3000 = 30%. O restante é que vira cripto para o cliente.
  ///
  /// Quando > 0, a taxa on-chain da ordem é ZERO: a receita já foi tirada no
  /// lado fiat, e cobrar de novo no SOL seria cobrar duas vezes.
  fiatRetainedBps Int @default(3000)

  // ── Depósitos pelo provedor interno ──
  /// Quantos USDC (base units de 1 unidade) valem 1 unidade de cada moeda
  /// fiat, em JSON: {"USD":1,"EUR":1.08,"BRL":0.18}.
  ///
  /// É knob do operador de propósito: num trilho manual o câmbio é o que ELE
  /// consegue no banco, não uma cotação de mercado. Default 1 em tudo —
  /// correto para USD, e obriga a definir EUR/BRL antes de aceitar esses
  /// trilhos em vez de silenciosamente errar o valor.
  depositRatesJson String @default("{\"USD\":1,\"EUR\":1,\"BRL\":1}")

  updatedAt DateTime @updatedAt
}

/// Carteira Solana gerada pelo gateway para um cliente que não tem uma.
///
/// Guardar a chave privada faz do operador um CUSTODIANTE: o dinheiro é do
/// cliente, a chave é nossa. Duas defesas, e nenhuma delas é opcional:
///
///  • `encryptedSecret` é AES-256-GCM com chave em `WALLET_ENCRYPTION_KEY`.
///    Um dump do banco, sozinho, não move um lamport.
///  • `revealedAt` registra a entrega da chave ao cliente. Depois de revelada,
///    a carteira deixa de ser só nossa — e isso precisa ficar auditável.
///
/// O que NÃO existe aqui de propósito: a chave em claro, em nenhuma coluna,
/// em nenhum momento.
model CustomerWallet {
  id        String @id @default(cuid())
  /// Endereço público. É o destino do SOL na liquidação.
  publicKey String @unique

  /// Chave privada cifrada (base64). Ver `wallet.service.ts`.
  encryptedSecret String
  /// Nonce do AES-GCM (base64). Único por carteira.
  iv              String
  /// Tag de autenticação do GCM (base64). Sem ela o texto cifrado é maleável.
  authTag         String
  /// Versão do esquema de cifra, para permitir rotação futura sem adivinhação.
  cipherVersion   Int    @default(1)

  /// Quando o cliente pediu a chave. Null = nunca revelada.
  revealedAt DateTime?
  /// De onde veio o pedido de criação — só diagnóstico.
  clientIp   String?

  intents  DepositIntent[]
  /// Null enquanto a carteira for de um depósito avulso (sem conta).
  customer Customer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Conta de cliente.
///
/// A carteira nasce no CADASTRO, não a cada compra: é isso que faz o saldo do
/// cliente acumular num lugar só em vez de espalhar por N endereços órfãos.
/// Relação 1:1 com `CustomerWallet` — uma conta, uma carteira, para sempre.
model Customer {
  id    String @id @default(cuid())
  email String @unique

  /// scrypt: "scrypt$<salt base64>$<hash base64>". Nunca a senha em claro.
  passwordHash String

  /// A carteira da conta. Criada junto, no mesmo instante.
  walletId String         @unique
  wallet   CustomerWallet @relation(fields: [walletId], references: [id])

  sessions    CustomerSession[]
  intents     DepositIntent[]
  withdrawals Withdrawal[]

  clientIp    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([createdAt])
}

/// Sessão de login. Guardamos o HASH do token, nunca o token.
///
/// Sessão em tabela (e não JWT) porque aqui ela precisa ser revogável: se um
/// cliente perder o telefone, o operador apaga a linha e acabou. Com JWT
/// assinado isso exigiria uma lista de revogação — a mesma tabela, com mais
/// passos.
model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  clientIp  String?

  @@index([customerId])
  @@index([expiresAt])
}

/// Saque: SOL saindo da carteira custodiada para um endereço do cliente.
///
/// A linha nasce ANTES do envio e só depois recebe a assinatura. Um registro
/// SENT sem `signature` significa "pode ter saído" — é o estado que exige
/// olhar a chain, e é melhor tê-lo do que descobrir a saída só pelo saldo.
model Withdrawal {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  walletId   String

  /// Endereço de destino, escolhido pelo cliente.
  destination String
  lamports    BigInt

  signature String?
  status    String  @default("SENT") // SENT | FAILED
  lastError String?

  clientIp    String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([customerId, createdAt])
  @@index([walletId])
}

/// Loja que integra o gateway como meio de pagamento.
///
/// O modelo é o de qualquer PSP: a loja cria uma cobrança pela API, manda o
/// cliente dela para o checkout hospedado, e recebe um webhook quando o
/// dinheiro entra. Nada do fluxo interno muda — a cobrança da loja vira uma
/// `DepositIntent` como qualquer outra.
model Merchant {
  id   String @id @default(cuid())
  name String
  email String

  /// SHA-256 da chave de API. A chave em claro é mostrada UMA vez, na criação.
  /// Guardar o hash é o que impede que um dump do banco vire acesso às lojas.
  apiKeyHash   String @unique
  /// Prefixo visível (sk_live_a1b2…), só para a loja reconhecer qual chave é.
  apiKeyPrefix String

  /// Segredo com que assinamos os webhooks enviados a esta loja. Ela usa o
  /// mesmo para verificar que a notificação veio de nós.
  webhookSecret String

  /// URL padrão de notificação. A cobrança pode sobrescrever.
  callbackUrl String?

  // ── Portal da loja ──
  /// scrypt. Definida na aprovação e entregue junto com a chave de API.
  passwordHash String?
  /// Carteira Solana onde a loja recebe os saques em cripto.
  payoutWallet String?
  /// Como a loja prefere receber: `SOL` ou `FIAT`.
  preferredPayout String @default("SOL")
  /// Moeda do saque em fiat: BRL, USD ou EUR.
  payoutCurrency  String @default("BRL")
  /// Chave Pix, IBAN, dados da conta — texto livre, é o operador quem lê.
  payoutFiatDetails String?

  /// Nossa comissão sobre cada venda dela, em bps. 3000 = 30%.
  /// Snapshot por venda fica no lançamento, não aqui — mudar a comissão não
  /// pode reescrever o passado.
  commissionBps Int @default(3000)

  sessions    MerchantSession[]
  ledger      MerchantLedgerEntry[]
  withdrawals MerchantWithdrawal[]

  active    Boolean  @default(true)
  intents   DepositIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastUsedAt DateTime?

  @@index([active])
}

/// Pedido de uma loja para usar o gateway como checkout.
///
/// Fica separado de `Merchant` de propósito: um pedido é uma intenção de
/// alguém de fora, e um `Merchant` é uma credencial que cobra dinheiro. A
/// aprovação é o momento em que uma coisa vira a outra — e sem esse degrau o
/// formulário público estaria emitindo chave de API para qualquer um.
model MerchantApplication {
  id String @id @default(cuid())

  // ── Quem está pedindo ──
  companyName String
  legalName   String?
  taxId       String?
  email       String
  phone       String?
  website     String?

  /// Onde a loja quer receber os webhooks. Validado como https público.
  callbackUrl String?

  // ── O que pretende fazer ──
  /// Faixa de volume mensal esperada, na escolha da loja.
  expectedVolume String?
  description    String?

  /// `pendente` | `aprovado` | `recusado`
  status String @default("pendente")
  /// Anotação do operador — motivo da recusa, ou observação da aprovação.
  reviewNote String?

  /// Preenchido na aprovação: a loja que nasceu deste pedido.
  merchantId String? @unique

  clientIp   String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
}

/// Sessão do portal da loja. Mesmo desenho da sessão de cliente: guardamos o
/// hash do token, e a linha some para revogar o acesso.
model MerchantSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  clientIp  String?

  @@index([merchantId])
  @@index([expiresAt])
}

/// Livro-razão da loja, em fiat.
///
/// O saldo é a SOMA dos lançamentos, nunca um número guardado e atualizado. Um
/// campo `saldo` que se edita a cada venda diverge do histórico no primeiro
/// erro, e aí não há como saber qual dos dois está certo. Somar é mais lento e
/// não mente.
model MerchantLedgerEntry {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// `venda` credita, `saque` debita, `ajuste` faz os dois (sinal do valor).
  type String

  /// Positivo credita, negativo debita. Na moeda do lançamento.
  amount   Decimal
  currency String  @default("BRL")

  /// Quanto ficou com o gateway nesta venda, e a taxa aplicada. Guardados no
  /// lançamento porque a comissão da loja pode mudar amanhã.
  commissionAmount Decimal?
  commissionBps    Int?

  /// Origem: a cobrança que gerou o crédito, ou o saque que gerou o débito.
  intentId     String? @unique
  withdrawalId String? @unique

  description String?
  createdAt   DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([type])
}

/// Pedido de saque da loja: ela pede em fiat, recebe em cripto.
///
/// O valor em SOL não é fixado aqui — depende da cotação no instante da
/// conversão. Fixar no pedido criaria uma promessa que o mercado pode
/// desmentir entre o pedido e o envio.
model MerchantWithdrawal {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// Quanto a loja pediu, em fiat.
  amountFiat Decimal
  currency   String  @default("BRL")

  /// Como sai: `SOL` (on-chain, automático) ou `FIAT` (transferência manual).
  payoutMethod String @default("SOL")

  /// Destino em cripto. Vazio nos saques em fiat.
  ///
  /// Copiado no momento do pedido — trocar a carteira do cadastro depois não
  /// pode redirecionar um saque já pedido. Vale igual para os dados bancários.
  destinationWallet String

  /// Destino em fiat: chave Pix, IBAN, dados da conta.
  payoutDetails  String?
  /// Moeda do saque em fiat.
  payoutCurrency String @default("BRL")
  /// Estimativa na moeda de saída, pelo câmbio do operador no pedido.
  estimatedAmount Decimal?
  /// Quanto o operador de fato transferiu. Pode divergir da estimativa —
  /// câmbio do banco, taxa de remessa — e é este o número que vale.
  sentAmount Decimal?

  /// `pendente` | `aprovado` | `enviado` | `recusado`
  status String @default("pendente")

  /// Ordem que faz a conversão e o envio. Null até a aprovação.
  orderId   String?
  signature String?
  /// SOL efetivamente entregue, quando concluído.
  solSent   String?

  reviewNote  String?
  clientIp    String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  completedAt DateTime?

  @@index([merchantId, createdAt])
  @@index([status, createdAt])
}

/// Lock distribuído com lease (arrendamento).
///
/// Substitui os locks in-process, que não valem nada quando há mais de uma
/// instância — o caso normal em serverless. A exclusão vem do PRIMARY KEY:
/// `create` de um `name` que já existe falha atomicamente no banco, então
/// exatamente um processo ganha.
///
/// `expiresAt` evita lock eterno se o processo morrer no meio (função
/// serverless que estoura o tempo, container morto): passado o prazo, outro
/// processo pode roubar o lock. O `owner` garante que quem perdeu o lease não
/// libere o lock de quem o roubou.
model Lock {
  /// Ex.: "order:cuid...", "swap:global", "payout:global".
  name      String   @id
  /// Identificador aleatório de quem detém o lease.
  owner     String
  expiresAt DateTime
  acquiredAt DateTime @default(now())
  /// Só para diagnóstico no admin.
  meta      String?

  @@index([expiresAt])
}

/// Cache das taxas coletadas dos on-ramps — histórico de quem estava mais
/// barato e quando. Serve para auditar a escolha "sempre o melhor".
model ProviderFeeSnapshot {
  id String @id @default(cuid())

  provider     String
  fiatCurrency String
  /// Valor fiat consultado (a taxa costuma variar por faixa).
  fiatAmount   Decimal
  /// Custo total do provedor em bps sobre o valor fiat.
  costBps      Int
  /// Custo bruto reportado, para auditoria.
  rawFeeAmount String?
  available    Boolean  @default(true)
  error        String?
  /// true no provedor eleito mais barato nesta coleta.
  selected     Boolean  @default(false)

  collectedAt DateTime @default(now())

  @@index([fiatCurrency, collectedAt])
  @@index([provider, collectedAt])
}

/// Intenção de depósito — o "provedor" interno do gateway.
///
/// Existe porque um on-ramp de verdade (SpherePay/MoonPay) exige onboarding de
/// empresa: não dá para receber dinheiro hoje por ali. Aqui o operador é o
/// próprio provedor — o cliente paga por um trilho que o operador já tem (Pix,
/// SEPA, MB Way, Revolut) ou manda USDC direto, e a confirmação gera o MESMO
/// evento normalizado que um provedor externo geraria. A pipeline a jusante
/// (swap -> liquidação -> lucro -> distribuição) não sabe a diferença.
///
/// AWAITING_PAYMENT -> CONFIRMED (vira Order) | EXPIRED | CANCELLED
model DepositIntent {
  id String @id @default(cuid())

  /// Código curto que o cliente põe na descrição da transferência. É por ele
  /// que o operador liga o extrato bancário à intenção.
  reference String @unique
  /// PIX | SEPA | MBWAY | REVOLUT | USDC (ver `DepositMethod` em types).
  method    String

  fiatCurrency String
  fiatAmount   Decimal

  /// Destino do SOL. Validada como public key na criação.
  customerWallet String
  /// Preenchido quando a carteira foi gerada por nós (cliente sem carteira).
  /// Null = o cliente trouxe a dele, e nós não temos chave nenhuma.
  walletId       String?
  wallet         CustomerWallet? @relation(fields: [walletId], references: [id])

  /// Conta dona deste depósito. Null nos depósitos avulsos (sem cadastro).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // ── Origem: loja integrada pela API ──
  /// Null quando o depósito nasceu no nosso próprio checkout.
  merchantId         String?
  merchant           Merchant? @relation(fields: [merchantId], references: [id])
  /// Id do pedido no sistema da loja. É por ele que ela reconcilia do lado dela.
  merchantExternalId String?
  /// Para onde notificar. Sobrescreve o `callbackUrl` da loja.
  merchantCallbackUrl String?
  /// Para onde devolver o cliente depois de pagar.
  merchantReturnUrl   String?

  /// Estado da notificação à loja. Null = ainda não avisada.
  notifiedAt       DateTime?
  notifyAttempts   Int       @default(0)
  notifyLastError  String?

  /// SHA-256 do token entregue ao navegador que criou esta intenção.
  ///
  /// A `reference` sozinha não pode liberar a chave privada: ela aparece na
  /// URL, em prints e no histórico do navegador. Quem pede a chave precisa
  /// provar que é o mesmo navegador que criou o depósito. Guardamos só o hash
  /// — um dump do banco não devolve o token.
  claimTokenHash String?

  /// Base units de USDC que esta ordem vai consumir do vault.
  /// Para USDC é o valor que o cliente manda; para trilho fiat é
  /// `fiatAmount * taxa configurada` — o float de USDC é do operador.
  expectedInputRaw BigInt

  /// Snapshot da cotação mostrada ao cliente (auditoria de "eu vi X").
  quotedFeeBps      Int?
  quotedCustomerSol String?

  // ── Retenção em fiat ──
  /// bps retidos em fiat nesta intenção (snapshot da configuração).
  fiatRetainedBps    Int?
  /// Valor retido, na moeda do pagamento.
  retainedFiatAmount Decimal?

  // ── PSP (cartão) ──
  /// Id da preferência/checkout criada no PSP.
  pspPreferenceId String?
  /// Id do pagamento no PSP, quando ele existe. Reconciliação com o extrato.
  pspPaymentId    String?
  /// URL para onde o cliente é mandado para pagar. Não é segredo, mas some
  /// da visão pública depois de confirmada.
  pspCheckoutUrl  String?

  // ── Pix com QR (Mercado Pago) ──
  /// Payload "copia e cola" do Pix. É o que o app do banco entende.
  pixCopyPaste String?
  /// PNG do QR em base64, como o MP devolve. Guardado para a página não
  /// precisar gerar imagem nenhuma.
  pixQrBase64  String?
  /// Quando o QR deixa de ser aceito pelo banco (o MP define).
  pixExpiresAt DateTime?

  status  String  @default("AWAITING_PAYMENT")
  /// Ordem criada na confirmação. 1:1.
  orderId String? @unique

  /// Assinatura da tx do cliente (depósito USDC). UNIQUE: a mesma
  /// transferência nunca confirma duas intenções.
  depositSignature String? @unique
  /// "admin" ou "onchain-watch" — quem confirmou.
  confirmedBy      String?
  note             String?
  /// Só para rate limit e diagnóstico de abuso.
  clientIp         String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime
  confirmedAt DateTime?

  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([walletId])
  @@index([customerId])
  @@index([merchantId, createdAt])
  @@index([notifiedAt])
}
